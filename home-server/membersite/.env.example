# SIGNAL digital goods shop - configuration example
# Copy the values you need into real environment variables (never commit secrets).
# On Windows PowerShell, e.g.:
#   [Environment]::SetEnvironmentVariable("DB_BACKEND","sqlite","User")
# Then restart the service. Unset / default values are used if omitted.

# ---- Server ----
PORT=8080

# ---- Database backend: json | sqlite | mysql | postgres ----
# json      : zero dependency, data/*.json files (default)
# sqlite    : zero dependency, data/shop.db, tables created automatically
# mysql     : pip install pymysql
# postgres  : pip install psycopg2-binary
DB_BACKEND=json

# Local data directory (json files / sqlite file / admin credentials live here)
# DATA_DIR=C:\Users\romanovsky\WorkBuddy\2026-11-19-16-02-56\home-server\membersite\data
DB_SQLITE_PATH=

# ---- Relational DB connection (mysql / postgres only) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shop
DB_PASSWORD=
DB_NAME=shop
# For postgres, set DB_PORT=5432 and DB_USER=postgres as appropriate.

# ---- Member access control ----
# Comma-separated extra admins (email-code members). The FIRST registered user
# is always an admin. The /admin console uses its OWN username/password account
# (see data/admin-credentials.txt on first boot), independent of these.
ADMIN_EMAILS=

# ---- Admin console bootstrap ----
# Username created on first boot. Password is RANDOM and written to
# data/admin-credentials.txt (gitignored). Change it in the console afterwards.
ADMIN_BOOTSTRAP_USER=admin

# ---- Mail (Resend, see RESEND配置指南.md) ----
# RESEND_API_KEY=
